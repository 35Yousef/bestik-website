# ---------- App ----------
PORT=5000
JWT_SECRET=put-a-long-random-string-here

# Dashboard login (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=bestik123

# Where new-lead notifications go (can also be changed from dashboard → Settings)
ADMIN_EMAIL=hello@bestik.com

# ---------- SMTP (sending email) ----------
# Option A — local testing with the built-in mail catcher (npm run mail-catcher):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bestik" <no-reply@bestik.local>

# Option B — Gmail (needs 2-Step Verification + an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="Bestik" <yourname@gmail.com>

# Option C — Hostinger / cPanel mailbox:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@yourdomain.com
# SMTP_PASS=mailbox-password
# MAIL_FROM="Bestik" <hello@yourdomain.com>
